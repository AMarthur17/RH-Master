# ============================
# Configurações do Servidor
# ============================
PORT=3000
NODE_ENV=development

# ============================
# Banco de Dados Postgres
# ============================
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db # Nome do serviço no docker-compose
DB_PORT=5432
DB_NAME=rh_master
DB_SSL=false

# ============================
# Autenticação / Segurança
# ============================
JWT_SECRET=supersecretkey123   # Altere em produção
JWT_EXPIRES_IN=1d

# ============================
# Uploads de Arquivos
# ============================
UPLOADS_DIR=uploads
