# ============================
# Local Development Configuration
# Use this when running backend locally (not in Docker)
# ============================
PORT=3001
NODE_ENV=development

# ============================
# Banco de Dados Postgres (Local)
# ============================
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost # Use localhost when running outside Docker
DB_PORT=5432
DB_NAME=rh_master
DB_SSL=false

# ============================
# Autenticação / Segurança
# ============================
JWT_SECRET=supersecretkey123   # Altere em produção
JWT_EXPIRES_IN=1d

# ============================
# Uploads de Arquivos
# ============================
UPLOADS_DIR=uploads
